{
  "name": "better-auth-dynamodb",
  "version": "0.1.0",
  "description": "DynamoDB adapter for Better Auth",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "benchmark": "npx tsx scripts/benchmark.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirdender/better-auth-dynamodb.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "better-auth",
    "dynamodb",
    "adapter",
    "aws",
    "authentication",
    "session",
    "typescript"
  ],
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "better-auth": ">=1.6.0"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.800.0",
    "@aws-sdk/lib-dynamodb": "^3.800.0",
    "better-auth": "^1.6.14",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
